#!/usr/bin/env bash
set -e

show_help() {
    echo "Usage: run_model [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --config FILE          YAML config file (mutually exclusive with all other options)"
    echo "  --size str             Map size: 'center' or 'full' (default: center)"
    echo "  --max_cells int        Maximum number of cells (default: 20)"
    echo "  --density_param float  Population density weight (default: 0.5)"
    echo "  --green_param float    Green space weight (default: 0.5)"
    echo "  --streets_param float  Street space weight (default: 0.2)"
    echo "  --yard_param float     Yard space weight (default: 0.8)"
    echo "  --res_name str         Result name (default: result)"
    echo "  --help                 Show this help message"
    echo ""
    echo "Notes:"
    echo "- All float parameters should be in the range [0, 1]."
    echo "- The density_param and green_param should sum to 1."
    echo ""
    echo "Example:"
    echo ">> run_model.sh --config default_config.yaml"
    echo ">> run_model.sh --size full --max_cells 30 --density_param 0.7 --green_param 0.25 --streets_param 0.25 --uhei_param 0.25 --fragility_macro 0.25 --yard_param 1.0 --res_name result_my_spec"
    exit 0
}

# ============================
# Default values
# ============================

CONFIG=""
SIZE="center"
MAX_CELLS=20
DENSITY_PARAM=0.25
GREEN_PARAM=0.25
UHEI_PARAM=0.25
FRAGILITY_MACRO=0.25
ALPHA_UHEI=0.5
STREETS_PARAM=0.2
YARD_PARAM=0.8
RES_NAME="result"

OTHER_ARGS_SEEN=0

# ============================
# Parse parameters
# ============================

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --config)
            if [[ -n "$CONFIG" ]]; then
                echo "Error: --config specified more than once."
                exit 1
            fi
            CONFIG="$2"
            shift
            ;;
        --size|--max_cells|--density_param|--green_param|--uhei_param|--fragility_macro|--streets_param|--yard_param|--res_name)
            if [[ -n "$CONFIG" ]]; then
                echo "Error: --config cannot be combined with other parameters like $1"
                exit 1
            fi
            OTHER_ARGS_SEEN=1
            eval "$(echo "${1:2}" | tr '-' '_' | tr '[:lower:]' '[:upper:]')=\"$2\""
            shift
            ;;
        --help)
            show_help
            ;;
        *)
            echo "Unknown parameter: $1"
            show_help
            ;;
    esac
    shift
done

# ============================
# Load config if provided
# ============================

if [[ -n "$CONFIG" ]]; then
    echo "Loading config from $CONFIG..."

    if [[ ! -f "$CONFIG" ]]; then
        echo "Error: Config file '$CONFIG' does not exist."
        exit 1
    fi

    eval "$(python3 - <<EOF
import yaml
with open("$CONFIG") as f:
    cfg = yaml.safe_load(f)
required = ['size', 'max_cells', 'density_param', 'green_param', 'uhei_param', 'fragility_macro', 'alpha_uhei', 'streets_param', 'yard_param', 'res_name']
for key in required:
    if key not in cfg:
        raise SystemExit(f"Missing required config key: {key}")
    print(f"{key.upper()}='{cfg[key]}'")
EOF
)"
fi

# ============================
# config.yaml update
# ============================

echo "Updating config files..."
python3 config/update_config.py --size "$SIZE" --max_cells "$MAX_CELLS" --density_param "$DENSITY_PARAM" --green_param "$GREEN_PARAM" --uhei_param "$UHEI_PARAM" --fragility_macro "$FRAGILITY_MACRO" --alpha_uhei "$ALPHA_UHEI" --streets_param "$STREETS_PARAM" --yard_param "$YARD_PARAM"
echo ""

# ============================
# Run the scripts sequentially
# ============================

echo "Running preprocessing.py..."
python3 src/preprocessing.py --density_param "$DENSITY_PARAM" --green_param "$GREEN_PARAM" --uhei_param "$UHEI_PARAM" --fragility_macro "$FRAGILITY_MACRO"
echo ""

echo "Running data_parser.py..."
python3 src/data_parser.py --size "$SIZE" --max_cells "$MAX_CELLS" --streets_param "$STREETS_PARAM" --yard_param "$YARD_PARAM" --alpha_uhei "$ALPHA_UHEI"
echo ""

echo "Running solver.py..."
python3 src/solver.py --size "$SIZE" --res_name "$RES_NAME"
echo ""

echo "Pipeline completed successfully!"
